# Copy to .env.local.
#
# Neither variable below is `NEXT_PUBLIC_`, and that is the whole point of them.
# The browser never speaks to `central-api`: it calls this app's own
# `/api/v1/...` routes, and those run on the server, attach the service token, and
# forward the request. A `NEXT_PUBLIC_` name would be inlined into the client
# bundle at build time, so the token would ship to every browser that loads the
# console. `next build` is what enforces the server-only side; this file is what
# keeps the values out of the bundle.
#
# If the token is missing, every view route answers 500 with
# "CENTRAL_API_SERVICE_TOKEN is not set" rather than calling the service
# unauthenticated. Failing closed is the point: a 401 from the service would look
# like a broken token, and a 403 like a wrong one, and neither says the
# configuration is missing.
CENTRAL_API_URL=http://localhost:4000
CENTRAL_API_SERVICE_TOKEN=dev-console-token

# Read by Next, not by the console's own code.
NEXT_PUBLIC_APP_NAME=Admin Dashboard
PORT=3005
