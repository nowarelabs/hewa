---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("blog")).sort((a: { data: { publishedAt: any; }; }, b: { data: { publishedAt: string; }; }) =>
  b.data.publishedAt.localeCompare(a.data.publishedAt),
);
---

<Base title="Hewa" description="The landing page, built with Astro.">
  <h1>Hewa</h1>
  <p class="subtitle">The landing page, built with Astro.</p>

  {posts.length === 0 ? <p>No posts yet.</p> : null}

  {
    posts.map((post: { id: any; data: { title: unknown; publishedAt: string | number | Date; description: any; }; }) => (
      <article>
        <h2>
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        </h2>
        <p class="tagline">
          {new Date(post.data.publishedAt).toISOString().slice(0, 10)}
          {post.data.description ? ` — ${post.data.description}` : null}
        </p>
      </article>
    ))
  }
</Base>
