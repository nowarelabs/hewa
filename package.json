{
  "name": "hewa",
  "version": "0.0.0",
  "private": true,
  "description": "Hewa monorepo, built with Vite+.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp run @hewa/website#dev",
    "prepare": "vp config",
    "changeset": "vp exec changeset",
    "release": "vp exec changeset version && vp install",
    "ci:publish": "vp run -r build && vp pm publish -r"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
