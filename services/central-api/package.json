{
  "name": "@hewa/central-api",
  "version": "0.0.0",
  "private": true,
  "description": "The public entry point that fronts every other service, and the console read surface.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp exec nest start --watch",
    "build": "vp exec tsc -p tsconfig.build.json",
    "start": "vp exec node dist/main.js",
    "db:generate": "vp exec drizzle-kit generate",
    "db:migrate": "vp exec drizzle-kit migrate",
    "db:seed": "vp exec tsx src/db/seed.ts",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@hewa/console-types": "workspace:*",
    "@hewa/errors": "workspace:*",
    "@hewa/marketplace-types": "workspace:*",
    "@hewa/observability": "workspace:*",
    "@hewa/response-codes": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@hewa/tsconfig": "workspace:*",
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
