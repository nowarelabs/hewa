  "failureReason": null
}

### Patch the status, with the reason a failure requires — 200
# `failureReason` is not optional on a `failed` movement, so it travels with the status
# rather than being something a second write has to remember.
PATCH {{host}}/api/v1/data/settlements/{{settlementId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "status": "failed",
  "failureReason": "Counterparty bank rejected the batch."
}

### A replace that drops the reason — 422 at the document
# `SettlementWrite` names every column, so a failed movement cannot be replaced by one that
# has stopped saying why it failed.
PUT {{host}}/api/v1/data/settlements/{{settlementId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "batch": "run-2026-03-01",
  "kind": "clearing",
  "status": "completed",
  "counterparty": "Sahara ISP",
  "amountMinor": 1250000,
  "feeMinor": 12500,
  "currency": "USD",
  "occurredAt": "2026-03-01T01:30:00.000Z"
}

### A negative fee — 422, because a fee is an amount charged and not a credit
POST {{host}}/api/v1/data/settlements
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "id": "stl-{{$guid}}",
  "batch": "run-2026-03-01",
  "kind": "clearing",
  "status": "completed",
  "counterparty": "Sahara ISP",
  "amountMinor": 1250000,
  "feeMinor": -1,
  "currency": "USD",
  "occurredAt": "2026-03-01T01:30:00.000Z",
  "failureReason": null
}

### A movement cannot be deleted — 404
DELETE {{host}}/api/v1/data/settlements/{{settlementId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}

# ═════════════════════════════════════════ monitors ══════════════════════════════════

### Create a monitor — 201, with `sla` nested
# So a commitment cannot arrive with a target and no credit rate: the numbers that describe
# one commitment are one object, and half of it is not a commitment.
POST {{host}}/api/v1/data/monitors
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "id": "{{monitorId}}",
  "account": "Sahara ISP",
  "nodeId": "nod-nbo-01",
  "nodeName": "Equinix Nairobi",
  "provider": "Equinix",
  "sla": {
    "targetBps": 9995,
    "actualBps": 9975,
    "creditNumerator": 1,
    "creditDenominator": 20
  },
  "packetLossPpm": 120,
  "latencyP95Ms": 12,
  "measuredAt": "{{observedAt}}"
}

### Read it back — 200, and `state` is derived by the service rather than written
GET {{host}}/api/v1/data/monitors/{{monitorId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}

### Replace the whole monitor — 200
PUT {{host}}/api/v1/data/monitors/{{monitorId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "account": "Sahara ISP",
  "nodeId": "nod-nbo-01",
  "nodeName": "Equinix Nairobi",
  "provider": "Equinix",
  "sla": {
    "targetBps": 9995,
    "actualBps": 9975,
    "creditNumerator": 1,
    "creditDenominator": 20
  },
  "packetLossPpm": 130,
  "latencyP95Ms": 13,
  "measuredAt": "{{observedAt}}"
}

### A patch carrying `state` — 422 as an unrecognised key, which is the point
# `state` is what the service computes from `targetBps` and `actualBps`. Accepting it on a
# write would let a caller set the conclusion and leave the measurements contradicting it.
PATCH {{host}}/api/v1/data/monitors/{{monitorId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "state": "compliant"
}

### A commitment far enough below target to be a breach — 200, on an exact figure
# 9995 − 9800 is 195 basis points of shortfall, and the credit is `195/20 = 9.75`, capped by
# the bill. Basis points rather than a percentage, so the shortfall is an integer and no
# float decides where the boundary is.
PATCH {{host}}/api/v1/data/monitors/{{monitorId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "sla": {
    "targetBps": 9995,
    "actualBps": 9800,
    "creditNumerator": 1,
    "creditDenominator": 20
  }
}

### Back inside the target — 200, and the whole `sla` travels again
# A patch makes each *top-level* field optional, but `sla` is one field holding four numbers,
# so it is all four or none, and `{ "sla": { "actualBps": 9999 } }` is a 422. The dashboard's
# editor sends the whole object for the same reason: its four `sla.*` fields build one
# nested object, and a commitment is not four independent measurements.
PATCH {{host}}/api/v1/data/monitors/{{monitorId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "sla": {
    "targetBps": 9995,
    "actualBps": 9999,
    "creditNumerator": 1,
    "creditDenominator": 20
  }
}

### Half a commitment — 422 at the nested object
PATCH {{host}}/api/v1/data/monitors/{{monitorId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "sla": {
    "targetBps": 9995
  }
}

### A packet loss above the column's own ceiling — 422
PATCH {{host}}/api/v1/data/monitors/{{monitorId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "packetLossPpm": 1000001
}

### A monitor cannot be deleted either — 404
DELETE {{host}}/api/v1/data/monitors/{{monitorId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}