# central-api's own endpoints, exercised with httpyac.
#
#   vp dev            # in services/central-api, serves on :4000
#   npx httpyac run src/qa.http --all -o short
#
# One convention runs through the whole file: a `###` line is a request, and the method
# line sits directly beneath it. Prose is `#`. A `###` opens a request whether or not a
# method follows it, so a sentence wrapped onto a second `###` becomes a request with no
# method and is sent as nothing — an empty block that counts as a request in the summary
# and matches nothing.
#
# **This is where the tokens belong.** The admin dashboard reaches these routes through its
# own handlers, which read the two secrets from the server's environment and attach them
# there; this file asks for them itself, so a refusal can be told apart from a proxy's.
# Both come from this service's own `.env` by key, so the file carries no secret of its own:
#
#   {{$dotenv CENTRAL_API_SERVICE_TOKEN}}
#   {{$dotenv CENTRAL_API_WRITE_TOKEN}}
#
# `{{$dotenv}}` takes the **key alone**, with no filename in front of it. The form with a
# path in it resolves to nothing, and then every guarded request below answers 401 — which
# looks exactly like a wrong token and is not one.
#
# Reads answer the envelope `{ "code": "0", "data": … }`. Writes answer the **bare record**,
# so an id is the response's `id` and not `data.id`.
#
# Ids are generated per run rather than fixed, so the file can be run twice with no reset: a
# fixed id would make the second run's create a 409, which is a fact about the rows left
# behind rather than about the route.
#
# Every status named in a `###` line is the one this service was asked for and answered.

@host = http://localhost:4000
@serviceToken = {{$dotenv CENTRAL_API_SERVICE_TOKEN}}
@writeToken = {{$dotenv CENTRAL_API_WRITE_TOKEN}}

# A literal, and not `{{$timestamp}}`: that renders as epoch milliseconds
# (`"1772000000000"`), and every timestamp column is an ISO datetime, so the variable would
# put a number in a body and draw a 422 naming the field.
@observedAt = 2026-03-01T05:00:00.000Z

# The spot's key carries the time the file was run, because a spot is addressed by
# `(pool, observedAt)` and not by an id — so this is the one place where a second run would
# otherwise collide with the first and the create below would be a 409.
@spotAt = {{$datetime iso8601}}

@nodeId = nod-{{$guid}}
@orderId = ord-{{$guid}}
@alertId = alt-{{$guid}}
@settlementId = stl-{{$guid}}
@monitorId = sla-{{$guid}}

# ═══════════════════════════════════════ health ═══════════════════════════════════════
# The one route with no token, because it has to answer before anything is configured: a
# deployment holding no credentials still has to be able to say so.

### Health, with no token — 200
GET {{host}}/health

### Health with a wrong service token — 200, because it guards nothing
GET {{host}}/health
x-hewa-service-token: not-the-token

# ══════════════════════════════ reads: sixteen sections ══════════════════════════════
# One endpoint per section, not one per view: a rail button is a destination with its own
# rows. Each answers 200 with the envelope above.

### Order book — 200
GET {{host}}/api/v1/market/book
x-hewa-service-token: {{serviceToken}}

### Prices — 200
GET {{host}}/api/v1/market/prices
x-hewa-service-token: {{serviceToken}}

### Venues — 200
GET {{host}}/api/v1/market/venues
x-hewa-service-token: {{serviceToken}}

### Nodes — 200
GET {{host}}/api/v1/infrastructure/nodes
x-hewa-service-token: {{serviceToken}}

### Headroom — 200
GET {{host}}/api/v1/infrastructure/headroom
x-hewa-service-token: {{serviceToken}}

### Providers — 200
GET {{host}}/api/v1/infrastructure/providers
x-hewa-service-token: {{serviceToken}}

### Movements — 200
GET {{host}}/api/v1/settlement/movements
x-hewa-service-token: {{serviceToken}}

### Settlement runs — 200
GET {{host}}/api/v1/settlement/runs
x-hewa-service-token: {{serviceToken}}

### Payouts — 200
GET {{host}}/api/v1/settlement/payouts
x-hewa-service-token: {{serviceToken}}

### Commitments — 200
GET {{host}}/api/v1/slas/commitments
x-hewa-service-token: {{serviceToken}}

### At risk — 200
GET {{host}}/api/v1/slas/at_risk
x-hewa-service-token: {{serviceToken}}

### Credits — 200
GET {{host}}/api/v1/slas/credits
x-hewa-service-token: {{serviceToken}}

### Alert feed — 200
GET {{host}}/api/v1/alerts/feed
x-hewa-service-token: {{serviceToken}}

### Outages — 200
GET {{host}}/api/v1/alerts/outages
x-hewa-service-token: {{serviceToken}}

### Capacity pressure — 200
GET {{host}}/api/v1/alerts/capacity
x-hewa-service-token: {{serviceToken}}

### Security events — 200
GET {{host}}/api/v1/alerts/security
x-hewa-service-token: {{serviceToken}}

# ═══════════════════════════════════════════ guards ══════════════════════════════════
# All four are 401, and that they are one answer rather than a spread is the point.
# `assertPresentedToken` asks two questions in order: is the *server* holding a credential to
# compare against, and does what arrived match it. No credential configured is a 503, and a
# mismatch is a 401 — so on a configured service every way of getting the token wrong is the
# same status, and no header can produce the 503. The two are told apart by `/health`
# answering 200 throughout.

### A read with no service token at all — 401
GET {{host}}/api/v1/market/book

### A read with the wrong service token — 401, and the comparison is constant-time
GET {{host}}/api/v1/market/book
x-hewa-service-token: not-the-token

### A write carrying only the read token — 401
# The read token and the write token are separate secrets held by separate parties, so a
# caller holding the first cannot write. The refusal is a 401 and not a 403, because the
# guard asks for a value and the value is absent.
POST {{host}}/api/v1/data/nodes
x-hewa-service-token: {{serviceToken}}
Content-Type: application/json

{
  "id": "nod-{{$guid}}",
  "name": "QA read token only",
  "kind": "ixp",
  "provider": "Northwind",
  "city": "Amsterdam",
  "country": "NL",
  "lat": 52.3676,
  "lng": 4.9041,
  "capacityGbps": 400,
  "utilisationBps": 8750,
  "status": "operational",
  "observedAt": "{{observedAt}}"
}

### A write with neither token — 401, and the service token is the one checked first
POST {{host}}/api/v1/data/nodes
Content-Type: application/json

{}

### A write with both tokens and no content type — 422
# Nest's body parser leaves the body `undefined` when nothing tells it the type, so the
# schema is handed nothing and refuses the document. Worth seeing because the dashboard's
# proxy is what sets that header, and a browser form that forgets it looks exactly like this.
POST {{host}}/api/v1/data/nodes
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}

{
  "id": "nod-{{$guid}}",
  "name": "QA untyped body",
  "kind": "ixp",
  "provider": "Northwind",
  "city": "Amsterdam",
  "country": "NL",
  "lat": 52.3676,
  "lng": 4.9041,
  "capacityGbps": 400,
  "utilisationBps": 8750,
  "status": "operational",
  "observedAt": "{{observedAt}}"
}

# The 503s cannot be sent, only configured, so they get no request here. Stop the service,
# delete one variable from `.env`, start it again, and the table below is what it answers:
#
#   CENTRAL_API_WRITE_TOKEN removed  →  /health 200, reads 200, every write 503 naming
#                                     CENTRAL_API_WRITE_TOKEN
#   CENTRAL_API_SERVICE_TOKEN removed  →  /health 200, every /api/v1 route 503 naming
#                                     CENTRAL_API_SERVICE_TOKEN
#
# Both are supported states rather than broken ones. A read-only deployment is a service
# that watches, given only the read credential; and a service holding no credential at all
# says so in the open rather than refusing every caller indistinguishably.

# ═══════════════════════════════════════════ nodes ═══════════════════════════════════
# The one resource exercised end to end, and the only one of the six that is DELETE-able, so
# all four record verbs appear here.

### Create a node — 201 with the bare record
POST {{host}}/api/v1/data/nodes
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "id": "{{nodeId}}",
  "name": "QA Amsterdam IX",
  "kind": "ixp",
  "provider": "Northwind",
  "city": "Amsterdam",
  "country": "NL",
  "lat": 52.3676,
  "lng": 4.9041,
  "capacityGbps": 400,
  "utilisationBps": 8750,
  "status": "operational",
  "observedAt": "{{observedAt}}"
}

### The same create again — 409, and the id is what collided
POST {{host}}/api/v1/data/nodes
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "id": "{{nodeId}}",
  "name": "QA Amsterdam IX",
  "kind": "ixp",
  "provider": "Northwind",
  "city": "Amsterdam",
  "country": "NL",
  "lat": 52.3676,
  "lng": 4.9041,
  "capacityGbps": 400,
  "utilisationBps": 8750,
  "status": "operational",
  "observedAt": "{{observedAt}}"
}

### Read one node back — 200
GET {{host}}/api/v1/data/nodes/{{nodeId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}

### Read a node that was never created — 404, naming what is not there
GET {{host}}/api/v1/data/nodes/nod-qa-9999
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}

### Patch one field — 200
PATCH {{host}}/api/v1/data/nodes/{{nodeId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "status": "degraded"
}

### An empty patch — 200, and the record is unchanged
PATCH {{host}}/api/v1/data/nodes/{{nodeId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{}

### Replace the whole record — 200
PUT {{host}}/api/v1/data/nodes/{{nodeId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "name": "QA Amsterdam IX renamed",
  "kind": "ixp",
  "provider": "Northwind",
  "city": "Amsterdam",
  "country": "NL",
  "lat": 52.3676,
  "lng": 4.9041,
  "capacityGbps": 400,
  "utilisationBps": 9100,
  "status": "operational",
  "observedAt": "{{observedAt}}"
}

### Replace one that is not there — 201, because a replace is also an upsert
PUT {{host}}/api/v1/data/nodes/nod-{{$guid}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "name": "QA upserted",
  "kind": "cdn_edge",
  "provider": "Northwind",
  "city": "Nairobi",
  "country": "KE",
  "lat": -1.3192,
  "lng": 36.9278,
  "capacityGbps": 100,
  "utilisationBps": 500,
  "status": "operational",
  "observedAt": "{{observedAt}}"
}

### A patch that names an id — 422, because `id` is not a field a patch may set
PATCH {{host}}/api/v1/data/nodes/{{nodeId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "id": "{{nodeId}}"
}

### A patch that breaks a column rule — 422 naming the field
PATCH {{host}}/api/v1/data/nodes/{{nodeId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "utilisationBps": 12000
}

### An instant as epoch milliseconds — 422, so a timestamp cannot arrive as a number
PATCH {{host}}/api/v1/data/nodes/{{nodeId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "observedAt": 1772000000000
}

### A create with no id — 422 at `id`, the column's refusal rather than the form's
POST {{host}}/api/v1/data/nodes
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "name": "QA nameless node",
  "kind": "ixp",
  "provider": "Northwind",
  "city": "Amsterdam",
  "country": "NL",
  "lat": 52.3676,
  "lng": 4.9041,
  "capacityGbps": 400,
  "utilisationBps": 8750,
  "status": "operational",
  "observedAt": "{{observedAt}}"
}

### A create with a fractional capacity — 422 rather than a rounded value
POST {{host}}/api/v1/data/nodes
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "id": "nod-{{$guid}}",
  "name": "QA fractional node",
  "kind": "ixp",
  "provider": "Northwind",
  "city": "Amsterdam",
  "country": "NL",
  "lat": 52.3676,
  "lng": 4.9041,
  "capacityGbps": 400.5,
  "utilisationBps": 8750,
  "status": "operational",
  "observedAt": "{{observedAt}}"
}

### A latitude past the pole — 422 naming `lat`
PATCH {{host}}/api/v1/data/nodes/{{nodeId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "lat": 91
}

### A path id carrying an encoded traversal — 404
# The id is validated as a string and the path is matched before any of it becomes a query,
# so a traversal is a lookup for a key that does not exist.
GET {{host}}/api/v1/data/nodes/..%2F..%2Fadmin
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}

### A spot id that is not a number — 422 at the parameter
# `market_spots.id` is a generated identity, so the path carries a number and the parameter
# is coerced here rather than looked up. The refusal is a 422 naming the parameter and not a
# 404, because `spots/not-a-number` is a bad path rather than a lookup that came back
# empty — and the dashboard answers the same 422 with the same message, since its proxy
# checks the id before forwarding.
GET {{host}}/api/v1/data/spots/not-a-number
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}

### A well-formed spot id that does not exist — 404
# The counterpart to the refusal above, and the reason the two are different statuses: this
# path is addressable and simply holds nothing.
GET {{host}}/api/v1/data/spots/999999999
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}

### Delete the node — 204, and no body
DELETE {{host}}/api/v1/data/nodes/{{nodeId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}

### It is gone — 404
GET {{host}}/api/v1/data/nodes/{{nodeId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}

### Deleting it twice — 404, naming what is not there
DELETE {{host}}/api/v1/data/nodes/{{nodeId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}

# ══════════════════════════════════════════ orders ═══════════════════════════════════

### Create an order — 201
# `currency` is the book's own, so `assertQuotedIn` has something true to check; a currency
# the market does not quote in is refused below.
POST {{host}}/api/v1/data/orders
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "id": "{{orderId}}",
  "pool": "nairobi_ixp",
  "side": "bid",
  "provider": "Northwind",
  "committedGbps": 40,
  "burstGbps": 60,
  "priceMinor": 540000,
  "currency": "USD",
  "submittedAt": "2026-03-01T02:00:00.000Z"
}

### Read one order back — 200
GET {{host}}/api/v1/data/orders/{{orderId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}

### Replace the whole order — 200
PUT {{host}}/api/v1/data/orders/{{orderId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "pool": "nairobi_ixp",
  "side": "bid",
  "provider": "Northwind",
  "committedGbps": 40,
  "burstGbps": 60,
  "priceMinor": 541000,
  "currency": "USD",
  "submittedAt": "2026-03-01T02:00:00.000Z"
}

### Burst below committed — 422 naming `burstGbps`, which is the field to correct
POST {{host}}/api/v1/data/orders
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "id": "ord-{{$guid}}",
  "pool": "nairobi_ixp",
  "side": "bid",
  "provider": "Northwind",
  "committedGbps": 40,
  "burstGbps": 10,
  "priceMinor": 540000,
  "currency": "USD",
  "submittedAt": "2026-03-01T02:00:00.000Z"
}

### A side the book does not have — 422 naming `side` and listing the two it does
POST {{host}}/api/v1/data/orders
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "id": "ord-{{$guid}}",
  "pool": "nairobi_ixp",
  "side": "sell",
  "provider": "Northwind",
  "committedGbps": 40,
  "burstGbps": 60,
  "priceMinor": 540000,
  "currency": "USD",
  "submittedAt": "2026-03-01T02:00:00.000Z"
}

### A price with a fractional minor unit — 422, never rounded
# Money is an integer count of minor units. `540000.75` is not a price in a currency with no
# subunit to hold the `.75`, so it is refused rather than rounded to `540001` — which would
# be a different price from the one asked for.
POST {{host}}/api/v1/data/orders
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "id": "ord-{{$guid}}",
  "pool": "nairobi_ixp",
  "side": "bid",
  "provider": "Northwind",
  "committedGbps": 40,
  "burstGbps": 60,
  "priceMinor": 540000.75,
  "currency": "USD",
  "submittedAt": "2026-03-01T02:00:00.000Z"
}

### A currency the market does not quote in — 422 from the service, not the schema
# `KES` is a real currency and is in the column's own vocabulary; what it fails is
# `assertQuotedIn`, which knows this market quotes `USD`. The distinction matters when
# reading a refusal: a currency the schema does not know is a 422 at the field, and one it
# knows but the market does not quote is a 422 from the service.
POST {{host}}/api/v1/data/orders
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "id": "ord-{{$guid}}",
  "pool": "nairobi_ixp",
  "side": "bid",
  "provider": "Northwind",
  "committedGbps": 40,
  "burstGbps": 60,
  "priceMinor": 540000,
  "currency": "KES",
  "submittedAt": "2026-03-01T02:00:00.000Z"
}

### Patch a price — minor units, so no currency rides along with it — 200
PATCH {{host}}/api/v1/data/orders/{{orderId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "priceMinor": 545000
}

### Withdraw the order — 204
DELETE {{host}}/api/v1/data/orders/{{orderId}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}

# ═══════════════════════════════════════════ spots ═══════════════════════════════════
# The odd one: the id is the column's and the write is addressed by the natural key the body
# carries. So `POST` and `PUT` on the collection are the same document, and each answers 201
# the first time and 200 once the row is there.
#
# A spot's id is the one value this file has to read back from a response, because it is the
# only row whose key the service decides. httpyac hands a named response to a request that
# declares a `# @ref` to it, and the parsed body sits directly on the name — so the id is
# the name, a dot, then `id`, with no `body` in between.

### Create a spot — 201, with the id the column made rather than one the body chose
# @name createSpot
POST {{host}}/api/v1/data/spots
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "pool": "nairobi_ixp",
  "priceMinor": 512000,
  "currency": "USD",
  "observedAt": "{{spotAt}}"
}

### Upsert the same spot — 200, because the row is now there
PUT {{host}}/api/v1/data/spots
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "pool": "nairobi_ixp",
  "priceMinor": 512000,
  "currency": "USD",
  "observedAt": "{{spotAt}}"
}

### Create that key again — 409, because `(pool, observedAt)` is already there
# The one refusal a spot has that is about the data rather than the shape of it: the key is
# unique, so a second create for it is a collision and not a duplicate to merge. `PUT` on
# the collection is the upsert that answers this case.
POST {{host}}/api/v1/data/spots
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "pool": "nairobi_ixp",
  "priceMinor": 512000,
  "currency": "USD",
  "observedAt": "{{spotAt}}"
}

### Read it by the id the column made — 200
# @ref createSpot
GET {{host}}/api/v1/data/spots/{{createSpot.id}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}

### Patch it — 200, and the body carries no key because the path carries the id
# @ref createSpot
PATCH {{host}}/api/v1/data/spots/{{createSpot.id}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "priceMinor": 513000
}

### A patch carrying the id — 422, because the path already named it
# @ref createSpot
PATCH {{host}}/api/v1/data/spots/{{createSpot.id}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "id": "{{createSpot.id}}",
  "priceMinor": 513000
}

### No `PUT` on a spot's record route — 404
# A spot's id is generated and its key is `(pool, observedAt)`, so there is nothing for a path
# id to address and no replace to perform; the upsert is the collection's `PUT` above. Note
# the status: Nest has no such route, so it is a 404, where the dashboard's own route
# answers 405 for the same request because it never forwards it.
# @ref createSpot
PUT {{host}}/api/v1/data/spots/{{createSpot.id}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "pool": "nairobi_ixp",
  "priceMinor": 514000,
  "currency": "USD",
  "observedAt": "{{spotAt}}"
}

### A spot cannot be deleted either — 404
# @ref createSpot
DELETE {{host}}/api/v1/data/spots/{{createSpot.id}}
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}

### A spot with no price in the body — 422 naming the field
PUT {{host}}/api/v1/data/spots
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "pool": "nairobi_ixp",
  "currency": "USD"
}

# ══════════════════════════════════════════ alerts ═══════════════════════════════════

### Create an alert — 201
POST {{host}}/api/v1/data/alerts
x-hewa-service-token: {{serviceToken}}
x-hewa-write-token: {{writeToken}}
Content-Type: application/json

{
  "id": "{{alertId}}",
  "title": "Latency up 45 ms on the primary path",
  "description": "Failover engaged at {{observedAt}}.",
  "category": "outage",
  "severity": "high",
  "entityId": "nod-nbo-01",
  "entityLabel": "Equinix Nairobi",
  "provider": "Equinix",
  "city": "Nairobi",
  "lat": -1.3192,
  "lng": 36.9278,
  "impactedGbps": 40,
  "affectedSlas": 3,
  "automatedAction": null,
  "raisedAt": "{{observedAt}}"
}

### Read one alert back — 200
