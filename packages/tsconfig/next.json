{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "hewa next app",
  // `include`, `exclude`, and `paths` are deliberately absent: every one of
  // them resolves relative to the file that declares it, so inheriting them
  // from here would point them at packages/tsconfig instead of the app.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [{ "name": "next" }]
  }
}
